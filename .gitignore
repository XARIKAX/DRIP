# deps
node_modules/
.pnpm-store/

# next
.next/
out/
next-env.d.ts

# builds
dist/
build/
*.tsbuildinfo

# ...except the route that is actually called build. `build/` has no leading slash, so
# it matches at every depth, and it quietly swallowed apps/web/src/app/build/layout.tsx —
# `git add -A` skipped it without a word and only the page.tsx beside it got committed,
# because `git mv` stages a rename explicitly and ignores the ignore file. The route
# would have shipped with no shell and no robots directive, and worked perfectly on the
# machine where the untracked file still existed. Re-include the directory itself; git
# cannot re-include a file whose parent directory is excluded, so this has to name the
# directory and not the files in it.
!apps/web/src/app/build/

# foundry
contracts/out/
contracts/cache/
contracts/broadcast/
# forge writes the invariant corpus next to the invocation, not the project root
cache/

# env
.env
.env.local
.env.*.local

