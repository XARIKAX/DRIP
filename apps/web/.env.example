# Chain the app talks to. Everything about the network lives in this file and in
# src/lib/chain.config.ts. Nothing else in the codebase knows what chain it is on.

# Local development: anvil.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_CHAIN_NAME=Anvil
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_EXPLORER_NAME=Local
NEXT_PUBLIC_EXPLORER_URL=http://localhost

# Robinhood Chain testnet (the real target, public since Feb 2026). The public RPC
# is rate limited; use an Alchemy Robinhood testnet endpoint for anything sustained.
# Faucet: https://faucet.testnet.chain.robinhood.com
# NEXT_PUBLIC_CHAIN_ID=46630
# NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain Testnet
# NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
# NEXT_PUBLIC_EXPLORER_NAME=Robinhood Chain Explorer
# NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# Arbitrum Sepolia (development stand in, same Orbit stack semantics).
# NEXT_PUBLIC_CHAIN_ID=421614
# NEXT_PUBLIC_CHAIN_NAME=Arbitrum Sepolia
# NEXT_PUBLIC_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# NEXT_PUBLIC_EXPLORER_NAME=Arbiscan
# NEXT_PUBLIC_EXPLORER_URL=https://sepolia.arbiscan.io

# WalletConnect project id. Injected wallets work without it; WalletConnect does not.
# Get one free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
