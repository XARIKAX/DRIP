# Chain the app talks to. Everything about the network lives in this file and in
# src/lib/chain.config.ts. Point these at Robinhood Chain testnet when access lands
# and nothing else in the codebase changes.

# 31337 = local anvil, 421614 = Arbitrum Sepolia
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_CHAIN_NAME=Anvil
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_EXPLORER_NAME=Local
NEXT_PUBLIC_EXPLORER_URL=http://localhost

# WalletConnect project id. Injected wallets work without it; WalletConnect does not.
# Get one free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
