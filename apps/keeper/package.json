{
  "name": "@drip-markets/keeper",
  "version": "0.1.0",
  "private": true,
  "description": "Pay-day keeper for Osinko: activates entitlements and settles dividends",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "once": "KEEPER_RUN_ONCE=1 tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@drip-markets/sdk": "workspace:*",
    "tsx": "^4.19.2",
    "viem": "^2.21.55"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
